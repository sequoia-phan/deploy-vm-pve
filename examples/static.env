# Example configuration for static IP-based VM deployment
# Copy this file to .env and modify as needed

# Proxmox VE host
PVE_HOST="192.168.1.27"
# PVE user (optional, defaults to root)
# PVE_USER="root"
# PVE password or use SSH agent (not stored here, use ssh-agent or token)
# For simplicity, we assume SSH key agent is set up.

# VM settings
VM_NAME="vm-template"
VM_ID="101"
CPU_CORES="2"
RAM_MB="2048"
DISK_GB="20"
# Static IP settings for the VM (inside the VM, via cloud-init)
IP_ADDRESS="192.168.1.50/24"  # Example: IP with CIDR netmask
GATEWAY="192.168.1.1"
DNS_SERVERS="8.8.8.8,8.8.4.4"

# SSH key for the ubuntu user (public key)
VM_SSH_PUB_KEY_PATH="$HOME/.ssh/id_ed25519.pub"

# Git repository for the high-throughput-io project
GIT_REPO_URL="https://github.com/yourusername/high-throughput-io.git"

# Whether to run health check after provisioning (set to true or false)
HEALTH_CHECK_ENABLED="false"
HEALTH_CHECK_TIMEOUT="300"  # seconds

# Cloud-init user data and network config will be generated by the script.