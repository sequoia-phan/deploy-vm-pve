# Example configuration for DHCP-based VM deployment
# Copy this file to .env and modify as needed

# Proxmox VE host
PVE_HOST="192.168.1.27"
# PVE user (optional, defaults to root)
# PVE_USER="root"
# PVE password or use SSH agent (not stored here, use ssh-agent or token)
# For simplicity, we assume SSH key agent is set up.

# VM settings
VM_NAME="ubuntu-test-cloudimg"
VM_ID="134"
CPU_CORES="1"
RAM_MB="512"
DISK_GB="20"
# If using DHCP, we don't set a static IP here; the VM will get IP via DHCP
# But we might want to set a hostname or leave empty for DHCP
IP_ADDRESS=""  # Empty for DHCP
# Alternatively, you can set a specific IP if you want to reserve via DHCP server, but leave empty and let DHCP assign.

# SSH key for the ubuntu user (public key)
VM_SSH_PUB_KEY_PATH="$HOME/.ssh/deploy_vm_key.pub"

# Git repository for a project
GIT_REPO_URL=""

# Whether to run health check after provisioning (set to true or false)
HEALTH_CHECK_ENABLED="false"
HEALTH_CHECK_TIMEOUT="300"  # seconds

# Cloud-init user data and network config will be generated by the script.